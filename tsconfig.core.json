{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "rootDir": "assets",
    "outDir": "temp/core-tests",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "assets/core/**/*.ts",
    "assets/input/**/*.ts",
    "assets/settings/**/*.ts",
    "assets/services/**/*.ts",
    "assets/runtime/**/*.ts",
    "assets/content/**/*.ts",
    "assets/save/**/*.ts"
  ]
}
