{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": ["@cocos/creator-types/engine"]
  },
  "include": ["assets/**/*.ts", "tools/types/cc-env.d.ts"]
}
